VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# The following are NOT read by the client — they're listed here for
# reference only. Set them in the Convex dashboard (Settings -> Environment
# Variables) or via `npx convex env set NAME value`. Never put secrets in
# VITE_-prefixed vars; those are bundled into the client.
#
# CLERK_JWT_ISSUER_DOMAIN=      # Clerk auth (convex/auth.config.ts)
# CLERK_WEBHOOK_SECRET=         # /clerk-webhook signature verification
# STRIPE_SECRET_KEY=            # convex/stripe.ts, convex/http.ts webhook
# STRIPE_WEBHOOK_SECRET=        # /stripe-webhook signature verification
# FAL_KEY=                      # convex/generation.ts (fal.ai design gen)
# PRINTIFY_API_TOKEN=           # convex/printify.ts
# PRINTIFY_SHOP_ID=             # convex/printify.ts
# PRINTIFY_WEBHOOK_SECRET=      # /printify-webhook HMAC verification (optional)
# SITE_URL=                     # e.g. https://oneshirt.app — Stripe redirect URLs
